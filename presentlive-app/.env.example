# Copy this file to .env and fill in the values from your API configuration page.
# https://comp2140-3ea651da.uqcloud.net/config/

# Base URL of the RESTful API. Normally left exactly as it is.
VITE_API_BASE_URL=https://comp2140-3ea651da.uqcloud.net/api

# Your API access token, from the Access token page. Required.
VITE_API_TOKEN=

# OpenAI-compatible endpoint and key from the AI page. Required for the two AI features.
VITE_AI_BASE_URL=https://comp2140-3ea651da.uqcloud.net/api/_ai/v1
VITE_AI_KEY=

# One of the models the course proxy allows: gpt-4o-mini, gpt-5-nano, gpt-5-mini
VITE_AI_MODEL=gpt-4o-mini
